# ALU-ELECT — copy to .env and fill in. Never commit the real file.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aluelect
SECRET_KEY=
# Peppers ballot commitments and student-number hashes. Rotating this
# invalidates every existing receipt, so treat it as permanent per election.
BALLOT_PEPPER=
FLASK_ENV=production
# Permissioned ledger (optional). Absent = AUDIT_LEDGER_DEVELOPMENT_MODE.
LEDGER_BACKEND=
LEDGER_ENDPOINT=
